  "yara_rules": [
    {
      "name": "多阶段下载器",
      "severity": "high",
      "file_types": [".ps1", ".bat", ".cmd", ".vbs", ".js", ".hta"],
      "strings": {
        "$download": "DownloadString",
        "$execute": "Invoke-Expression",
        "$hidden": "WindowStyle Hidden",
        "$bypass": "ExecutionPolicy Bypass"
      },
      "condition": "($download and $execute) or ($hidden and $bypass)"
    },
    {
      "name": "进程注入 + 持久化组合",
      "severity": "critical",
      "file_types": [".exe", ".dll", ".sys", ".ps1", ".bat", ".vbs", ".js", ".c", ".cpp", ".h"],
      "strings": {
        "$inject": "CreateRemoteThread",
        "$persist": "CurrentVersion\\\\Run",
        "$alloc": "VirtualAllocEx"
      },
      "condition": "($inject or $alloc) and $persist"
    }
  ],

  "dangerous_extensions": [
    ".exe", ".dll", ".sys", ".bat", ".cmd", ".ps1",
    ".vbs", ".vbe", ".js", ".jse", ".wsf", ".wsh",
    ".hta", ".scr", ".pif", ".cpl", ".msi", ".msp",
    ".com", ".gadget", ".reg"
  ],

  "heuristic_rules": [
    {
      "name": "高熵值检测",
      "threshold": 7.2,
      "description": "熵值超过7.2可能表示加密/混淆"
    },
    {
      "name": "双扩展名检测",
      "description": "检测 .pdf.exe 等伪装扩展名"
    },
    {
      "name": "脚本混淆检测",
      "min_entropy": 5.5,
      "min_length": 500,
      "description": "短高熵脚本可能是混淆的恶意代码"
    }
  ]
}
