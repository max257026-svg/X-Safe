  "pattern_signatures": [
    {
      "name": "PHP Webshell — 一句话木马",
      "severity": "critical",
      "pattern": "<\\?php[\\s\\S]*?@?\\s*(eval|assert|system|exec|shell_exec|passthru|popen|proc_open)\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE|SERVER)\\[",
      "type": "webshell",
      "description": "PHP 一句话木马，攻击者可通过 HTTP 参数执行任意命令"
    },
    {
      "name": "ASP Webshell",
      "severity": "critical",
      "pattern": "<%\\s*(eval|execute|ExecuteGlobal)\\s*\\(\\s*(request|Request)\\(",
      "type": "webshell",
      "description": "ASP/ASPX Webshell 检测"
    },
    {
      "name": "PowerShell 下载执行",
      "severity": "high",
      "pattern": "(IEX|Invoke-Expression|Invoke-WebRequest|Net\\.WebClient).*(DownloadString|DownloadFile|DownloadData)",
      "type": "dropper",
      "file_types": [".ps1", ".bat", ".cmd", ".vbs", ".js", ".htm", ".html", ".hta"],
      "description": "PowerShell 远程下载并执行恶意代码"
    },
    {
      "name": "PowerShell 编码命令",
      "severity": "high",
      "pattern": "-e(nc(odedcommand)?)?\\s+[A-Za-z0-9+/=]{100,}",
      "type": "obfuscation",
      "description": "PowerShell Base64 编码命令执行"
    },
    {
      "name": "注册表持久化",
      "severity": "high",
      "pattern": "(HKLM|HKCU|HKEY_LOCAL_MACHINE|HKEY_CURRENT_USER)\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\(Run|RunOnce|RunServices)",
      "type": "persistence",
      "file_types": [".bat", ".cmd", ".ps1", ".vbs", ".js", ".reg", ".inf"],
      "description": "Windows 注册表持久化机制"
    },
    {
      "name": "计划任务持久化",
      "severity": "medium",
      "pattern": "schtasks\\s*/create.*(/sc\\s+(onstart|onlogon|daily|hourly)|/tn\\s+\\w+)",
      "type": "persistence",
      "description": "通过计划任务实现持久化"
    },
    {
      "name": "WMI 持久化",
      "severity": "high",
      "pattern": "__EventFilter|CommandLineEventConsumer|ActiveScriptEventConsumer|__FilterToConsumerBinding",
      "type": "persistence",
      "file_types": [".ps1", ".vbs", ".js", ".bat", ".cmd", ".mof"],
      "description": "WMI 事件订阅持久化"
    },
    {
      "name": "进程注入技术",
      "severity": "critical",
      "pattern": "(VirtualAllocEx|WriteProcessMemory|CreateRemoteThread|NtCreateThreadEx|QueueUserAPC|SetWindowsHookEx)",
      "type": "injection",
      "file_types": [".exe", ".dll", ".sys", ".bin", ".ps1", ".bat", ".vbs", ".vbe", ".js", ".jse", ".c", ".cpp", ".h", ".hpp", ".cs"],
      "description": "进程注入 API 调用"
    },
    {
      "name": "凭据窃取",
      "severity": "critical",
      "pattern": "(mimikatz|sekurlsa::|lsadump::|kerberos::|procdump.*lsass|comsvcs\\.dll.*MiniDump)",
      "type": "credential_theft",
      "file_types": [".exe", ".dll", ".ps1", ".bat", ".vbs", ".js", ".c", ".cpp", ".h"],
      "description": "凭据窃取工具/命令"
    },
    {
      "name": "勒索软件加密行为",
      "severity": "critical",
      "pattern": "(vssadmin\\s+delete\\s+shadows|wbadmin\\s+delete\\s+catalog|bcdedit\\s+/set.*bootstatuspolicy|cipher\\s+/w:)",
      "type": "ransomware",
      "file_types": [".exe", ".dll", ".ps1", ".bat", ".cmd", ".vbs", ".js"],
      "description": "勒索软件典型行为：删除卷影副本、禁用恢复"
    },
    {
      "name": "反沙箱检测",
      "severity": "medium",
      "pattern": "(IsDebuggerPresent|CheckRemoteDebuggerPresent|NtQueryInformationProcess|GetTickCount.*sleep|rdtsc)",
      "type": "evasion",
      "file_types": [".exe", ".dll", ".sys", ".ps1", ".bat", ".vbs", ".c", ".cpp", ".h", ".hpp", ".cs"],
      "description": "反调试/反沙箱检测技术"
    },
    {
      "name": "Base64 编码混淆",
      "severity": "low",
      "pattern": "(FromBase64String|base64_decode|atob|btoa)\\s*\\(\\s*['\\\"][A-Za-z0-9+/=]{100,}['\\\"]",
      "type": "obfuscation",
      "description": "长 Base64 编码字符串 — 常见混淆手段"
    }
  ],

